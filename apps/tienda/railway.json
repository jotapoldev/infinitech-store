{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter tienda build",
    "watchPatterns": ["apps/tienda/**", "packages/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter tienda start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "sleepApplication": true
  }
}
